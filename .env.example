# MongoDB connection used by the API and pipeline
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=yottaflex
# MongoDB 7 needs AVX; use mongo:7 on AVX-capable hosts
MONGO_IMAGE=mongo:4.4

# Express API
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Vite client (dev server proxies /api by default)
VITE_API_URL=/api
VITE_API_PROXY=http://localhost:4000
